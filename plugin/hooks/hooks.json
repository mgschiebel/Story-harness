{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/skaldsaga", "hook", "session-start"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
